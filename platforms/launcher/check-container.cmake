# Bounded, read-only probes. SDK image selection belongs to sdk-image.sh.
execute_process(COMMAND "${ENGINE}" info
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE detail TIMEOUT 5)
if(NOT result STREQUAL "0")
    message(STATUS "Kobo builds unavailable: '${ENGINE} info' failed or timed out.")
    string(STRIP "${detail}" detail)
    if(detail)
        message(STATUS "${detail}")
    endif()
    if(HOST STREQUAL "mac")
        message(STATUS "Open Docker Desktop and wait until its engine is ready; verify with: ${ENGINE} info")
        message(STATUS "Setup: https://docs.docker.com/desktop/setup/install/mac-install/")
    else()
        message(STATUS "Start your container engine and verify with: ${ENGINE} info")
        message(STATUS "For systemd Docker Engine: sudo systemctl start docker (rootless: systemctl --user start docker)")
        message(STATUS "Setup: https://docs.docker.com/engine/install/")
        if(detail MATCHES "[Pp]ermission denied")
            message(STATUS "Configure Docker access for your user: https://docs.docker.com/engine/install/linux-postinstall/")
        endif()
    endif()
    message(STATUS "Docker is optional for desktop builds and native tests. Continuing.")
    return()
endif()
foreach(target qt5 qt6)
    execute_process(COMMAND sh "${ROOT}/platforms/sdk-image.sh" "${target}"
        OUTPUT_VARIABLE image OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${ENGINE}" image inspect "${image}"
        RESULT_VARIABLE available OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
    if(available STREQUAL "0")
        message(STATUS "Kobo ${target}: prepared SDK image is ready.")
    else()
        message(STATUS "Kobo ${target}: prepared SDK image is missing. Download it before building:")
        message(STATUS "  \"${ENGINE}\" pull ${image}")
    endif()
endforeach()
