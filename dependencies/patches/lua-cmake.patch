--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,16 @@
+cmake_minimum_required(VERSION 3.22)
+project(Lua LANGUAGES C)
+set(CMAKE_C_STANDARD 99)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+set(CMAKE_C_EXTENSIONS ON)
+file(GLOB sources "${CMAKE_CURRENT_SOURCE_DIR}/src/*.c")
+list(FILTER sources EXCLUDE REGEX "/(lua|luac)\\.c$")
+add_library(lua STATIC ${sources})
+target_include_directories(lua PUBLIC "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>")
+if(APPLE)
+    target_compile_definitions(lua PRIVATE LUA_USE_MACOSX)
+elseif(UNIX)
+    target_compile_definitions(lua PRIVATE LUA_USE_POSIX)
+endif()
+install(TARGETS lua ARCHIVE DESTINATION lib)
+install(FILES src/lua.h src/luaconf.h src/lualib.h src/lauxlib.h src/lua.hpp DESTINATION include)
